#include <dt-bindings/zmk/matrix_transform.h>
#include "chocofi_knob-layouts.dtsi"

/ {
  chosen {
    zmk,kscan = &kscan0;
    zmk,physical-layout = &chocofi_knob_layout;
  };

  default_transform: keymap_transform_0 {
    compatible = "zmk,matrix-transform";
    columns = <11>;
    rows = <4>;
    map = <
      RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
      RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
      RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
                              RC(3,2) RC(3,3) RC(3,4)    RC(3,6) RC(3,7) RC(3,8)
    >;
  };

  kscan0: kscan {
    compatible = "zmk,kscan-composite";
    rows = <4>;
    columns = <11>;

    matrix {
      kscan = <&kscan_matrix>;
    };

    encoder_push {
      kscan = <&kscan_encoder_push>;
      col-offset = <10>;
    };
  };

  kscan_matrix: kscan_matrix {
    compatible = "zmk,kscan-gpio-matrix";
    wakeup-source;

    diode-direction = "col2row";

    col-gpios
      = <&gpio0 0 GPIO_ACTIVE_HIGH>
      , <&gpio0 1 GPIO_ACTIVE_HIGH>
      , <&gpio0 2 GPIO_ACTIVE_HIGH>
      , <&gpio0 3 GPIO_ACTIVE_HIGH>
      , <&gpio0 4 GPIO_ACTIVE_HIGH>
      , <&gpio0 5 GPIO_ACTIVE_HIGH>
      , <&gpio0 6 GPIO_ACTIVE_HIGH>
      , <&gpio0 7 GPIO_ACTIVE_HIGH>
      , <&gpio0 8 GPIO_ACTIVE_HIGH>
      , <&gpio0 9 GPIO_ACTIVE_HIGH>
      ;

    row-gpios
      = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      ;
  };

  kscan_encoder_push: kscan_encoder_push {
    compatible = "zmk,kscan-gpio-direct";
    wakeup-source;

    input-gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
  };

  encoder_left: encoder_left {
    compatible = "alps,ec11";
    a-gpios = <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    b-gpios = <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    steps = <80>;
    status = "okay";
  };

  sensors: sensors {
    compatible = "zmk,keymap-sensors";
    sensors = <&encoder_left>;
    triggers-per-rotation = <20>;
  };
};

&chocofi_knob_layout {
  transform = <&default_transform>;
  kscan = <&kscan0>;
};
